@model RoomListViewModel

@functions {
    // Every pager link carries the current filter, so paging inside a filtered list keeps the
    // filter. Criteria that were not chosen are left out of the URL entirely rather than sent as
    // empty values.
    private string PageUrl(int page)
    {
        var values = new Dictionary<string, object?> { ["page"] = page };

        if (Model.Filter.CountryId is { } countryId)
        {
            values["countryId"] = countryId;
        }

        if (Model.Filter.CityId is { } cityId)
        {
            values["cityId"] = cityId;
        }

        if (Model.Filter.AddressId is { } addressId)
        {
            values["addressId"] = addressId;
        }

        // Pointing at Index rather than Grid means the pager still works with scripting off: it
        // becomes an ordinary page load. catalogue.js intercepts the click and fetches the grid
        // on its own.
        return Url.Action("Index", "Room", values) ?? "#";
    }
}

@if (Model.Page.Items.Count == 0)
{
    <p class="lead text-body-secondary">No rooms match this filter.</p>
}

<div class="room-grid">
    @foreach (var room in Model.Page.Items)
    {
        <div class="card flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img class="room-poster" src="@room.LogoPath" alt="@room.Name" loading="lazy" />
                    <div class="card-body">
                        <span class="badge rounded-pill text-bg-success" title="Rating">@room.Rating</span>
                        <span class="badge rounded-pill text-bg-warning" title="Fear level">@room.FearLevel</span>
                        <span class="badge rounded-pill text-bg-danger" title="Difficulty">@room.Difficulty</span>
                        <h5 class="card-title room-title mt-2">@room.Name</h5>
                        <p class="card-text room-blurb">@room.Description</p>
                    </div>
                </div>
                <div class="flip-card-back">
                    <img class="room-poster" src="@room.LogoPath" alt="" loading="lazy" />
                    <div class="card-body">
                        <p class="card-text">@room.MinPlayers&ndash;@room.MaxPlayers players</p>
                        <p class="card-text">@room.TimeToPass.TotalMinutes.ToString("0") minutes</p>
                        <p class="card-text">@room.Company.Name</p>
                        <p class="card-text">
                            @room.Address.Street.Name @room.Address.HouseNumber,
                            @room.Address.City.Name, @room.Address.Country.Name
                        </p>
                        <p class="card-text">@room.Phone</p>
                        <p class="card-text">@room.Email</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<nav class="mt-3" aria-label="Room list pages" data-total-count="@Model.Page.TotalCount">
    <ul class="pagination justify-content-center">
        @if (Model.Page.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link js-page-link" data-page="@(Model.Page.PageNumber - 1)"
                   href="@PageUrl(Model.Page.PageNumber - 1)" aria-label="Previous page">&laquo;</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
        }

        @for (var i = 1; i <= Model.Page.TotalPages; i++)
        {
            if (i == Model.Page.PageNumber)
            {
                <li class="page-item active" aria-current="page"><span class="page-link">@i</span></li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link js-page-link" data-page="@i" href="@PageUrl(i)">@i</a>
                </li>
            }
        }

        @if (Model.Page.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link js-page-link" data-page="@(Model.Page.PageNumber + 1)"
                   href="@PageUrl(Model.Page.PageNumber + 1)" aria-label="Next page">&raquo;</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
        }
    </ul>
</nav>
