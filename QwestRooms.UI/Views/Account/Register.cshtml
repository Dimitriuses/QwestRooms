@model QwestRooms.UI.Models.UserRegisterVM

@{
    ViewBag.Title = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2>Create an account</h2>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Login)
                @Html.TextBoxFor(m => m.Login, new { @class = "form-control", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Login, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                <small class="form-text text-muted">
                    At least 6 characters, including an upper case letter, a lower case letter,
                    a digit and a symbol.
                </small>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
            @Html.ActionLink("Log in instead", "Login", "Account", null, new { @class = "btn btn-link" })
        }
    </div>
</div>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
