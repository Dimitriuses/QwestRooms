@using QwestRoom.BLL.DTOModels

@model IReadOnlyList<AddressDTO>

@if (Model.Count == 0)
{
    <span class="dropdown-item-text text-muted">No addresses</span>
}

@foreach (var item in Model)
{
    <button type="button" class="dropdown-item js-address" data-id="@item.Id">
        @item.Street.Name @item.HouseNumber
    </button>
}
