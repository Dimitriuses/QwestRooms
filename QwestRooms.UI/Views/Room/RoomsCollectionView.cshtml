@using QwestRooms.UI.Models

@model RoomListViewModel

@* Every pager link carries the current filter, so paging inside a filtered list keeps the
   filter applied. *@
@functions {
    object PageLinkRoute(RoomListViewModel model, int page)
    {
        return new
        {
            page = page,
            countryId = model.Filter.CountryId,
            cityId = model.Filter.CityId,
            addressId = model.Filter.AddressId
        };
    }
}

@if (Model.Rooms.Count == 0)
{
    <p class="lead text-muted">No rooms match this filter.</p>
}

@foreach (var item in Model.Rooms)
{
    <div class="card flip-card" style="width: 18rem; height: 36rem; float: left; margin: 5px;">
        <div class="flip-card-inner">
            <div class="flip-card-front" style="background-color:white;">
                <img class="card-img-top border border-primary room-logo"
                     style="width: 18rem; height: 18rem; object-fit: cover;"
                     src="@item.LogoPath" alt="@item.Name" />
                <div class="card-body">
                    <span class="badge badge-pill badge-success" title="Rating">@item.Rating</span>
                    <span class="badge badge-pill badge-warning" title="Fear level">@item.FearLevel</span>
                    <span class="badge badge-pill badge-danger" title="Difficulty">@item.Difficulty</span>
                    <h5 style="height: 3.6rem; overflow: hidden; text-overflow: ellipsis;" class="card-title">@item.Name</h5>
                    <p style="height: 8rem; overflow: hidden; text-overflow: ellipsis;" class="card-text">@item.Description</p>
                </div>
            </div>
            <div class="flip-card-back" style="background-color:black; color:white">
                <img class="card-img-top border border-primary room-logo"
                     style="width: 18rem; height: 18rem; object-fit: cover;"
                     src="@item.LogoPath" alt="@item.Name" />
                <div class="card-body">
                    <p class="card-text">@item.MinPlayers&ndash;@item.MaxPlayers players</p>
                    <p class="card-text">@item.TimeToPass.TotalMinutes.ToString("0") minutes</p>
                    <p class="card-text">@item.Company.Name</p>
                    <p class="card-text">
                        @item.Address.Street.Name @item.Address.HouseNumber,
                        @item.Address.City.Name, @item.Address.Country.Name
                    </p>
                    <p class="card-text">@item.Phone</p>
                    <p class="card-text">@item.Email</p>
                </div>
            </div>
        </div>
    </div>
}

<nav style="clear:left" aria-label="Room list pages">
    <ul class="pagination justify-content-center flex-wrap">
        @if (Model.Page.HasPreviousPage)
        {
            <li class="page-item">
                @Html.ActionLink("«", "RoomsPartial", PageLinkRoute(Model, Model.Page.PageNumber - 1),
                    new { @class = "page-link js-page-link", aria_label = "Previous page" })
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">«</span></li>
        }

        @for (int i = 1; i <= Model.Page.TotalPages; i++)
        {
            if (i == Model.Page.PageNumber)
            {
                <li class="page-item active"><span class="page-link">@i</span></li>
            }
            else
            {
                <li class="page-item">
                    @Html.ActionLink(i.ToString(), "RoomsPartial", PageLinkRoute(Model, i),
                        new { @class = "page-link js-page-link" })
                </li>
            }
        }

        @if (Model.Page.HasNextPage)
        {
            <li class="page-item">
                @Html.ActionLink("»", "RoomsPartial", PageLinkRoute(Model, Model.Page.PageNumber + 1),
                    new { @class = "page-link js-page-link", aria_label = "Next page" })
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">»</span></li>
        }
    </ul>
</nav>
