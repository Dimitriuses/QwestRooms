@using QwestRooms.UI.Models

@model RoomCatalogViewModel

@{
    ViewBag.Title = "Rooms";
}

<style>
    .flip-card {
        perspective: 1000px;
    }

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        transition: transform 0.8s;
        transform-style: preserve-3d;
    }

    .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);
    }

    .flip-card-front, .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
    }

    .flip-card-front {
        background-color: #bbb;
        color: black;
    }

    .flip-card-back {
        background-color: dodgerblue;
        color: white;
        transform: rotateY(180deg);
    }

    .dropdown-scroll {
        max-height: 300px;
        overflow-y: auto;
    }
</style>

<a class="btn btn-primary mb-2" data-toggle="collapse" href="#filterPanel" role="button"
   aria-expanded="false" aria-controls="filterPanel">Filters</a>

<div class="collapse mb-3" id="filterPanel">
    <div class="card card-body">
        <div class="form-row align-items-end">
            <div class="col-auto">
                <label class="d-block">Country</label>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="countryButton"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Any
                    </button>
                    <div id="countryMenu" class="dropdown-menu dropdown-scroll" aria-labelledby="countryButton">
                        @Html.Partial("CountryCollectionView", Model.Countries)
                    </div>
                </div>
            </div>

            <div class="col-auto">
                <label class="d-block">City</label>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="cityButton"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" disabled>
                        Any
                    </button>
                    <div id="cityMenu" class="dropdown-menu dropdown-scroll" aria-labelledby="cityButton"></div>
                </div>
            </div>

            <div class="col-auto">
                <label class="d-block">Address</label>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="addressButton"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" disabled>
                        Any
                    </button>
                    <div id="addressMenu" class="dropdown-menu dropdown-scroll" aria-labelledby="addressButton"></div>
                </div>
            </div>

            <div class="col-auto">
                <button type="button" id="applyFilter" class="btn btn-primary">Apply</button>
                <button type="button" id="clearFilter" class="btn btn-outline-secondary">Clear</button>
            </div>
        </div>
    </div>
</div>

<div id="rooms">
    @Html.Partial("RoomsCollectionView", Model.List)
</div>

<script>
    (function () {
        // The selected criteria live here rather than in Session, so two browser tabs can hold
        // different filters and every request carries its own state.
        var filter = { countryId: null, cityId: null, addressId: null };

        var urls = {
            rooms: '@Url.Action("RoomsPartial", "Room")',
            cities: '@Url.Action("CitiesPartial", "Room")',
            addresses: '@Url.Action("AddressesPartial", "Room")'
        };

        function loadRooms(page) {
            $.get(urls.rooms, {
                page: page || 1,
                countryId: filter.countryId,
                cityId: filter.cityId,
                addressId: filter.addressId
            }, function (html) {
                $('#rooms').html(html);
            });
        }

        function reset(which, label) {
            filter[which + 'Id'] = null;
            $('#' + which + 'Button').text(label).prop('disabled', which !== 'country');
            $('#' + which + 'Menu').empty();
        }

        $('#countryMenu').on('click', '.js-country', function () {
            filter.countryId = $(this).data('id');
            $('#countryButton').text($(this).text().trim());
            reset('city', 'Any');
            reset('address', 'Any');
            $.get(urls.cities, { countryId: filter.countryId }, function (html) {
                $('#cityMenu').html(html);
                $('#cityButton').prop('disabled', false);
            });
        });

        $('#cityMenu').on('click', '.js-city', function () {
            filter.cityId = $(this).data('id');
            $('#cityButton').text($(this).text().trim());
            reset('address', 'Any');
            $.get(urls.addresses, { countryId: filter.countryId, cityId: filter.cityId }, function (html) {
                $('#addressMenu').html(html);
                $('#addressButton').prop('disabled', false);
            });
        });

        $('#addressMenu').on('click', '.js-address', function () {
            filter.addressId = $(this).data('id');
            $('#addressButton').text($(this).text().trim());
        });

        $('#applyFilter').on('click', function () {
            loadRooms(1);
        });

        $('#clearFilter').on('click', function () {
            filter = { countryId: null, cityId: null, addressId: null };
            $('#countryButton').text('Any');
            reset('city', 'Any');
            reset('address', 'Any');
            loadRooms(1);
        });

        // The pager is re-rendered with each page of results, so bind by delegation.
        $('#rooms').on('click', '.js-page-link', function (e) {
            e.preventDefault();
            $.get(this.href, function (html) {
                $('#rooms').html(html);
            });
        });
    })();
</script>
