{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
    }
  },
  "tasks": [
    {
      "label": "restore",
      "type": "shell",
      "command": "./tools/dev.ps1 restore",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "./tools/dev.ps1 build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "./tools/dev.ps1 test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "detail": "Build, start IIS Express and open the browser",
      "type": "shell",
      "command": "./tools/dev.ps1 run",
      "problemMatcher": []
    },
    {
      "label": "stop",
      "type": "shell",
      "command": "./tools/dev.ps1 stop",
      "problemMatcher": []
    },
    {
      "label": "reseed database",
      "detail": "Drop the local database so the next run reloads MockData/*.sql",
      "type": "shell",
      "command": "./tools/dev.ps1 reseed",
      "problemMatcher": []
    }
  ]
}
