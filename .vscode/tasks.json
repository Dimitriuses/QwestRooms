{
  "version": "2.0.0",

  // tools/dev.ps1 is written to Windows PowerShell 5.1 rules as well as PowerShell 7, so it runs
  // under either. Windows gets powershell.exe, which is always present; everywhere else needs
  // pwsh, which is the only PowerShell there is on Linux and macOS.
  "options": {
    "shell": {
      "executable": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
    }
  },
  "windows": {
    "options": {
      "shell": {
        "executable": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
      }
    }
  },
  "tasks": [
    {
      "label": "restore",
      "type": "shell",
      "command": "./tools/dev.ps1 restore",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "./tools/dev.ps1 build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "./tools/dev.ps1 test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "detail": "Start the site on http://localhost:5188",
      "type": "shell",
      "command": "./tools/dev.ps1 run",
      "problemMatcher": []
    },
    {
      "label": "reseed database",
      "detail": "Delete the local SQLite file so the next run reloads MockData/*.sql",
      "type": "shell",
      "command": "./tools/dev.ps1 reseed",
      "problemMatcher": []
    },
    {
      "label": "screenshots",
      "detail": "Start the site, drive it in a browser and write docs/images/*.png",
      "type": "shell",
      "command": "./tools/dev.ps1 screenshots",
      "problemMatcher": []
    }
  ]
}
